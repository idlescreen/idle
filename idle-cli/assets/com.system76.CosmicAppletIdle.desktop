[Desktop Entry]
Name=IdleScreen
Comment=IdleScreen screensaver & ambient control panel applet
Type=Application
Exec=cosmic-idle
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Idle;Screensaver;
Icon=com.system76.CosmicAppletIdle-symbolic
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=50
